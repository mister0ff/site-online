# ===== OBRIGATÓRIO =====
# String aleatória longa (32+ caracteres). Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Access Token de PRODUÇÃO do Mercado Pago (painel > Suas integrações). NUNCA coloque no front-end nem no GitHub.
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (painel MP > Webhooks > "Chave secreta")
MP_WEBHOOK_SECRET=
# URL pública https da loja, sem barra no final
BASE_URL=https://sualoja.com.br

# ===== DADOS DO VENDEDOR (aparecem nos Termos) =====
SELLER_NAME=Seu Nome ou Razão Social
SUPPORT_EMAIL=contato@sualoja.com.br

# ===== OPCIONAL =====
PORT=3000
PRICE=7
# Atrás de proxy/CDN (Render, Railway, Cloudflare, Nginx): use 1
TRUST_PROXY=0
# Teto diário de pedidos e de chamadas ao Mercado Pago (corta tudo ao atingir)
DAILY_ORDER_CAP=300
DAILY_MP_CALL_CAP=1500
# Anti-bot (Cloudflare Turnstile, grátis). Se preenchidos, o formulário passa a exigir o desafio.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Interruptor de emergência: 1 pausa as vendas. Também funciona criando o arquivo data/STOP
EMERGENCY_STOP=0
